# ptCenter v2 — Environment Configuration
# Copy this file to .env and fill in your values:
# cp .env.example .env
# NEVER commit .env to version control

# AI Model API Keys 

# Google Gemini (Free — recommended)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI (Paid)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude (Paid)
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-latest

# Ollama (Free — local)
# Install: https://ollama.com/download
# Pull a model first:
# Recommended Models:
#   ollama pull llama3 
#   ollama pull qwen2.5:3b (Fast, good on low-end machines)
#   ollama pull xploiter/pentester (Pentesting-specific, may be outdated but fast)
#   ollama pull supergoatscriptguy/mythos-sec:8b (Pentesting-specific, more up-to-date but more resource-intensive)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Which model to use by default (gemini | openai | claude | ollama)
ACTIVE_AI_MODEL=gemini

# Output & Logging
# Where to save scan outputs, reports, and logs
# Defaults to /tmp/ptcenter_outputs if unset
OUTPUT_DIR=

# Subprocess timeout in seconds (default: 300)
COMMAND_TIMEOUT=300

# Optional API Keys 

# Shodan (requires paid plan)
# Get key: https://account.shodan.io/
SHODAN_API_KEY=

# TrueCaller (requires a registered account)
# Get installation ID: https://github.com/sumithemmadi/truecallerpy
TRUECALLER_INSTALLATION_ID=
